{
  "private": true,
  "repository": "kategengler/ember-cli-browserstack",
  "license": "MIT",
  "scripts": {
    "format": "pnpm --filter '*' format",
    "lint": "pnpm --filter '*' lint",
    "lint:fix": "pnpm --filter '*' lint:fix",
    "test": "pnpm --filter '*' test",
    "lint:format": "pnpm --filter '*' lint:format",
    "lint:js": "pnpm --filter '*' lint:js",
    "lint:js:fix": "pnpm --filter '*' lint:js:fix",
    "test:node": "pnpm --filter '*' test:node",
    "test:browserstack": "pnpm browserstack:connect && pnpm test:ember:browserstack && pnpm browserstack:disconnect && pnpm browserstack:results",
    "browserstack:connect": "ember browserstack:connect",
    "browserstack:disconnect": "ember browserstack:disconnect",
    "browserstack:results": "ember browserstack:results"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">= 20.19"
  }
}
